# Secrets / env
.env
.env.*
!.env.example
*secrets*
*credentials*
# ...pero el materializador de secretos NO contiene ninguno: solo IDs de Secrets
# Manager, que es la referencia que SÍ queremos ver en el código en vez del valor.
# La regla de arriba se los tragó en silencio y `make cloud-deploy` acabó
# dependiendo de dos ficheros que solo existían en un portátil. Lo ancla
# `api/tests/test_settings_produccion.py::test_todo_lo_que_el_despliegue_embebe_esta_en_git`.
!deploy/cloud/takab-secrets.sh
!deploy/cloud/takab-secrets.service

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / web
node_modules/
dist/
build/
.vite/
coverage/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Backups / bundles (contenido duplicado)
files.zip
takab-docs/design/Design System/Dashboard Alertamiento Sismico.zip

# Claude Code local settings (config del asistente, no del proyecto)
.claude/settings.local.json

# Terraform plans y material sensible de aprovisionamiento
*.tfplan
tfplan
certs-*/
.env.e2e

# graphify (grafo de conocimiento local, salida de tooling)
graphify-out/

# SOC local interactivo (make soc-local): spool/buffer/logs efímeros
.local-soc/

# Playwright (M-7): artefactos de ejecución del smoke local
web/test-results/
web/playwright-report/

# Cotización / BOM del gabinete: material comercial y de compras, no del producto
cotizacion/

# Marca de versión que escribe deploy/edge/deploy.sh en el gabinete. Es un artefacto
# DEL DESPLIEGUE, no del repo: commitearla haría que el rsync empujara un SHA viejo
# y el gabinete reportaría una versión que no corre — justo lo que este mecanismo
# existe para impedir.
edge/FW_VERSION
