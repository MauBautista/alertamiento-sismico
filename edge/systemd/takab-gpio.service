# TAKAB Ailert — proceso mínimo del camino de vida (WR-1 + relés + reflejo SASMEX→sirena).
# Es el proceso más crítico del gabinete (T-1.3): sin ObsPy/NumPy, arranca <1 s.
# Instalar en el Pi 5 real. Ver takab-docs/runbooks/RUNBOOK-SPOF-02-ruta-hardware-sirena.md.
[Unit]
Description=TAKAB Ailert — proceso GPIO del camino de vida (SASMEX->sirena)
Documentation=file:///opt/takab/takab-docs/runbooks/RUNBOOK-SPOF-02-ruta-hardware-sirena.md
After=network.target time-sync.target
# [T-2.70] SIN LÍMITE DE ARRANQUES — ver la nota gemela en takab-edge.service.
# Con el default (5 en 10 s) y RestartSec=1, este proceso agota el burst en 5 s
# y queda en `failed` definitivamente. Es el proceso MÁS crítico del gabinete:
# rendirse no es una opción. Pero reintentar SIN ESPACIAR tampoco: ver
# `RestartSteps=` en [Service]. Va en [Unit]: en [Service] systemd la ignora
# en silencio y `systemd-analyze verify` sale 0 igual. Y al revés también:
# RestartSteps=/RestartMaxDelaySec=/TimeoutStopSec= NO se suben aquí (systemd
# las descartaría igual de callado). Las seis están ancladas en
# test_cada_directiva_vigilada_vive_donde_systemd_la_lee.
StartLimitIntervalSec=0

[Service]
# [T-2.70.a·D3] `notify` y no `simple`. Con `simple`, `systemctl start` vuelve
# cuando systemd forkeó el proceso — no cuando el proceso es DUEÑO de los pines,
# que es lo único que el traspaso puede aceptar como terminado. `run_gpio_process`
# ya emite `sd_notify(READY=1)` DESPUÉS de tomar el cerrojo, fijar la pin factory,
# construir los cinco relés, armar los tres botones y sembrar el contacto
# sostenido (SPOF-02); hasta hoy ese aviso era código muerto (M10 de la auditoría
# de D1). `takab-edge` se queda en `simple`: no emite READY y con `notify` se
# quedaría en `activating` hasta que systemd lo matara.
Type=notify
# El proceso corre en producción (sin simuladores): usa el backend GPIO nativo (lgpio).
# OJO al orden de precedencia, que NO es el del archivo: systemd.exec(5) dice
# «Settings from these files override settings made with Environment=», así que si
# /etc/takab/edge.env declarase TAKAB_EDGE_DEV_MODE, GANA EL ARCHIVO. Es la misma
# exposición que ya tiene takab-edge.service, y ahora la comparten: provisionar
# dev_mode en edge.env pondría a los DOS procesos en MockFactory a la vez (un
# gabinete que no protege), nunca a uno solo — que era el fallo peor.
Environment=TAKAB_EDGE_DEV_MODE=false
# [T-2.70.a·D3 · CRITERIO 2] LA IDENTIDAD DEL GABINETE, Y SOBRE TODO EL MAPA DE
# PINES. Sin esta línea el DUEÑO DE LOS PINES arrancaría con los defaults de
# código —`GpioPins`, `failsafe`, tenant/site/gateway de dev—, o sea energizando
# los pines EQUIVOCADOS de un gabinete cableado: el peor fallo imaginable de esta
# tarea. Antes no importaba porque esta unidad no corría (`Conflicts=`); desde D3
# es la que sostiene la sirena, el gas y los retenedores.
# Las dos unidades leen EL MISMO archivo a propósito: es lo que impide que
# discrepen sobre qué pin es cuál y sobre qué canal reposa energizado.
# El camino de vida sigue sin CONSUMIR secretos ni nube (reglas de oro 1 y 2): la
# clave HMAC de comandos remotos la usa el supervisor, nunca este proceso mínimo.
EnvironmentFile=/etc/takab/edge.env
# CWD escribible: lgpio crea .lgd-nfy* en el directorio de trabajo y /opt es
# de solo lectura bajo ProtectSystem=strict (misma trampa que takab-edge).
# Desde A-2: el proceso fija LGPIOFactory EXPLÍCITA y truena si no puede
# (ensure_prod_pin_factory) — sin fallback silencioso a native/sysfs.
WorkingDirectory=/var/lib/takab
# [T-2.70] `/opt/takab/edge` ES UN SYMLINK a `releases/<id>/edge`, y por eso
# este `ExecStart` no cambia nunca: lo que decide qué versión corre es a dónde
# apunta el enlace, y sólo lo repunta `/opt/takab/bin/canary.sh` tras verificar
# la release nueva. systemd resuelve la ruta AL EJECUTAR, así que un repunte no
# afecta al proceso vivo hasta su próximo arranque — que es justo lo que hace
# reversible una actualización.
ExecStart=/opt/takab/edge/.venv/bin/takab-gpio

# El camino de vida se reinicia SIEMPRE y rápido ante cualquier caída (SPOF-02).
Restart=always
RestartSec=1
# [T-2.70·rev] REINTENTO INFINITO **ESPACIADO** — nota completa y medición en
# takab-edge.service. Resumen: el ciclo de vida de este proceso ENERGIZA y
# DE-ENERGIZA `GAS_VALVE` (FAIL_CLOSE) y `DOOR_RETAINER` (NORMALLY_CLOSED),
# porque ambos reposan energizados; medido en test_deploy_artifacts.py como
# 2 transiciones eléctricas por ciclo de proceso. Con RestartSec=1 y sin techo,
# un crash-loop mueve la válvula de gas 3600 veces por hora INDEFINIDAMENTE.
# Interpolación geométrica de razón 300^(1/5) ≈ 3.13 (systemd.service(5)):
#
#     1 s · 3 s · 10 s · 31 s · 96 s · 300 s · 300 s · …
#
# El PRIMER reintento sigue siendo a 1 s (SPOF-02: las caídas transitorias se
# recuperan igual de rápido que antes); sólo los reintentos ENCADENADOS se
# espacian ⇒ 6 ciclos en los primeros ~2.3 min y 12/hora a régimen.
# Par indivisible: sin RestartMaxDelaySec=, systemd IGNORA RestartSteps= sin
# error. Ambas desde systemd v254; el Pi (Debian 13 trixie) trae 257.
RestartSteps=5
RestartMaxDelaySec=300
# [T-2.70] Ventana de parada declarada, no heredada del default de systemd.
# 90 s = el valor efectivo de hoy: la línea documenta y ancla, no cambia nada.
# Acortarlo exige medir en el Pi (ver la nota extensa en takab-edge.service).
TimeoutStopSec=90
# [T-2.70.a·D3] VENTANA DE ARRANQUE, que `Type=notify` acaba de volver REAL.
# Con `simple` este plazo era inerte (systemd da la unidad por arrancada en el
# fork). Con `notify`, si el `READY=1` no llega, systemd MATA el proceso al
# vencer — y ese proceso puede estar sano y sosteniendo los pines, con lo que su
# muerte cicla gas y retenedores cada plazo + backoff.
# Las dos direcciones cuestan, y por eso el número se declara:
#   · corto  ⇒ mata a un dueño sano que tardó en anunciarse (medido exec→cerrojo:
#              0.60 s en x86/dev, ~1.0 s con los imports de producción; el margen
#              del Pi 4 NO está medido — GATE-HW);
#   · infinity ⇒ un arranque colgado a mitad de `_arrancar_hardware` (relés a
#              medio construir, sin reflejo) no se rescata NUNCA: un edificio sin
#              alertamiento en silencio, que es el peor desenlace de la ficha.
# 90 s es el default de systemd: esta línea no cambia el comportamiento, lo hace
# revisable — misma doctrina que `TimeoutStopSec=`.
TimeoutStartSec=90
# Endurecimiento mínimo (proceso auditable; sin escrituras al sistema salvo
# /var/lib/takab, que además es el CWD que lgpio necesita escribible).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/takab
# Watchdog de servicio: complementa al watchdog de hardware BCM2712 (system.conf,
# RuntimeWatchdogSec=10). Requiere que el proceso emita sd_notify WATCHDOG=1 (pendiente,
# hardware-gated); hasta entonces, Restart=always cubre las caídas del proceso.
# WatchdogSec=10

[Install]
WantedBy=multi-user.target
