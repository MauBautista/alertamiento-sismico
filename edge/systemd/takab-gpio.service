# TAKAB Ailert — proceso mínimo del camino de vida (WR-1 + relés + reflejo SASMEX→sirena).
# Es el proceso más crítico del gabinete (T-1.3): sin ObsPy/NumPy, arranca <1 s.
# Instalar en el Pi 5 real. Ver takab-docs/runbooks/RUNBOOK-SPOF-02-ruta-hardware-sirena.md.
[Unit]
Description=TAKAB Ailert — proceso GPIO del camino de vida (SASMEX->sirena)
Documentation=file:///opt/takab/takab-docs/runbooks/RUNBOOK-SPOF-02-ruta-hardware-sirena.md
After=network.target time-sync.target
# [T-2.70] SIN LÍMITE DE ARRANQUES — ver la nota gemela en takab-edge.service.
# Con el default (5 en 10 s) y RestartSec=1, este proceso agota el burst en 5 s
# y queda en `failed` definitivamente. Es el proceso MÁS crítico del gabinete:
# rendirse no es una opción. Pero reintentar SIN ESPACIAR tampoco: ver
# `RestartSteps=` en [Service]. Va en [Unit]: en [Service] systemd la ignora
# en silencio y `systemd-analyze verify` sale 0 igual. Y al revés también:
# RestartSteps=/RestartMaxDelaySec=/TimeoutStopSec= NO se suben aquí (systemd
# las descartaría igual de callado). Las seis están ancladas en
# test_cada_directiva_vigilada_vive_donde_systemd_la_lee.
StartLimitIntervalSec=0

[Service]
Type=simple
# El proceso corre en producción (sin simuladores): usa el backend GPIO nativo (lgpio).
Environment=TAKAB_EDGE_DEV_MODE=false
# El camino de vida NO consume secretos ni la nube (reglas de oro 1 y 2): el reflejo
# SASMEX→sirena debe arrancar SIEMPRE. La clave HMAC de comandos remotos la usa el
# servicio de nube/comandos aparte (supervisor), NUNCA este proceso mínimo.
# CWD escribible: lgpio crea .lgd-nfy* en el directorio de trabajo y /opt es
# de solo lectura bajo ProtectSystem=strict (misma trampa que takab-edge).
# Desde A-2: el proceso fija LGPIOFactory EXPLÍCITA y truena si no puede
# (ensure_prod_pin_factory) — sin fallback silencioso a native/sysfs.
WorkingDirectory=/var/lib/takab
ExecStart=/opt/takab/edge/.venv/bin/takab-gpio

# El camino de vida se reinicia SIEMPRE y rápido ante cualquier caída (SPOF-02).
Restart=always
RestartSec=1
# [T-2.70·rev] REINTENTO INFINITO **ESPACIADO** — nota completa y medición en
# takab-edge.service. Resumen: el ciclo de vida de este proceso ENERGIZA y
# DE-ENERGIZA `GAS_VALVE` (FAIL_CLOSE) y `DOOR_RETAINER` (NORMALLY_CLOSED),
# porque ambos reposan energizados; medido en test_deploy_artifacts.py como
# 2 transiciones eléctricas por ciclo de proceso. Con RestartSec=1 y sin techo,
# un crash-loop mueve la válvula de gas 3600 veces por hora INDEFINIDAMENTE.
# Interpolación geométrica de razón 300^(1/5) ≈ 3.13 (systemd.service(5)):
#
#     1 s · 3 s · 10 s · 31 s · 96 s · 300 s · 300 s · …
#
# El PRIMER reintento sigue siendo a 1 s (SPOF-02: las caídas transitorias se
# recuperan igual de rápido que antes); sólo los reintentos ENCADENADOS se
# espacian ⇒ 6 ciclos en los primeros ~2.3 min y 12/hora a régimen.
# Par indivisible: sin RestartMaxDelaySec=, systemd IGNORA RestartSteps= sin
# error. Ambas desde systemd v254; el Pi (Debian 13 trixie) trae 257.
RestartSteps=5
RestartMaxDelaySec=300
# [T-2.70] Ventana de parada declarada, no heredada del default de systemd.
# 90 s = el valor efectivo de hoy: la línea documenta y ancla, no cambia nada.
# Acortarlo exige medir en el Pi (ver la nota extensa en takab-edge.service).
TimeoutStopSec=90
# Endurecimiento mínimo (proceso auditable; sin escrituras al sistema salvo
# /var/lib/takab, que además es el CWD que lgpio necesita escribible).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/takab
# Watchdog de servicio: complementa al watchdog de hardware BCM2712 (system.conf,
# RuntimeWatchdogSec=10). Requiere que el proceso emita sd_notify WATCHDOG=1 (pendiente,
# hardware-gated); hasta entonces, Restart=always cubre las caídas del proceso.
# WatchdogSec=10

[Install]
WantedBy=multi-user.target
