{
  "name": "@takab/landing",
  "version": "1.0.0",
  "private": true,
  "description": "Landing pública de TAKAB Ailert — takabailert.com",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test": "astro build && node --test tests/contenido.test.mjs",
    "e2e": "playwright test --config tests/playwright.config.ts",
    "audit": "lhci autorun --config=tests/lighthouserc.json"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@lhci/cli": "^0.15.0",
    "@playwright/test": "^1.61.1",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
