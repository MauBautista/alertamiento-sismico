---
// Layout raíz de la landing pública. El contrato de dirección (impeccable)
// vive como primer hijo del <body> y sobrevive al build de producción.
import "../styles/tokens.css";
import "../styles/global.css";
import { Image } from "astro:assets";
import logoTakab from "../assets/img/logo-takab-technology.png";
import logoAilert from "../assets/img/imagotipo-takab-ailert-negativo.png";
import sairaUrl from "../assets/fonts/saira-condensed-700.woff2?url";
import archivoUrl from "../assets/fonts/archivo-400.woff2?url";
import { CONTACTO_EMAIL } from "../config";

interface Props {
  title: string;
  description: string;
  /** Ruta servida (con .html en subpáginas): canónica = apex + path */
  path: string;
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const canonical = `https://takabailert.com${path === "/" ? "/" : path}`;
const rev = import.meta.env.PUBLIC_REV ?? "dev";
const anio = 2026;
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://takabailert.com/#organization",
  name: "TAKAB TECHNOLOGY",
  url: "https://takabailert.com/",
  logo: "https://takabailert.com/apple-touch-icon.png",
  email: CONTACTO_EMAIL,
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#050B14" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={sairaUrl}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={archivoUrl}
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TAKAB Ailert" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://takabailert.com/og-v3.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="TAKAB Ailert: una señal, todo el inmueble en acción"
    />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://takabailert.com/og-v3.png" />
    <meta
      name="twitter:image:alt"
      content="TAKAB Ailert: una señal, todo el inmueble en acción"
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organization)}
    />
  </head>
  <body>
    <!--
    THESIS: La landing recorre el sistema completo: señal SASMEX, actuación física por zonas, app móvil, coordinación operativa, evidencia y reingreso.
    OWN-WORLD: Comando cinematografico v3 — negro azulado #050B14, navy y azul de la identidad TAKAB, rojo #FF2D1A solo para alerta; Saira Condensed display, Archivo cuerpo, JetBrains Mono telemetria; instrumentos tecnicos, reticula y luz de señal sin glassmorphism ni imagenes ficticias.
    STORY: El comprador entiende cómo una misma alerta avanza desde la recepción del inmueble hasta las personas y el centro de operaciones, y cómo continúa después del movimiento.
    FIRST VIEWPORT: titular a tres lineas, CTA y corte arquitectonico animado con gabinetes de apoyo, estrobos y vista móvil; el sismograma cierra el primer acto sin ocultar el LCP.
    FORM: tercera version elegida por el usuario — comando cinematografico, tecnica y escaneable, con la identidad de los logos entregados.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance.
    -->
    <a class="salto" href="#contenido">Saltar al contenido</a>

    <header class="barra">
      <div class="marco barra__fila">
        <a class="barra__marca" href="/" aria-label="TAKAB Ailert — inicio">
          <Image
            src={logoAilert}
            alt="TAKAB Ailert"
            width={188}
            format="webp"
            loading="eager"
          />
        </a>
        <nav class="barra__nav-escritorio" aria-label="Navegación principal">
          <ul class="barra__nav mono">
            <li><a href="/#flujo">El flujo</a></li>
            <li><a href="/#alerta-temprana">La ventaja</a></li>
            <li><a href="/#gabinete">El inmueble</a></li>
            <li><a href="/#app-movil">La app</a></li>
            <li><a href="/#post-sismo">Post-sismo</a></li>
            <li><a href="/#consola">Operaciones</a></li>
            <li><a href="/#instalacion">Configuración</a></li>
            <li><a class="barra__cta" href="/#contacto">Contacto</a></li>
          </ul>
        </nav>
        <nav class="barra__nav-movil" aria-label="Navegación móvil">
          <details class="menu-movil">
            <summary class="mono">Menú <i aria-hidden="true"></i></summary>
            <ul class="menu-movil__lista mono">
              <li><a href="/#flujo">01 · El flujo</a></li>
              <li><a href="/#alerta-temprana">02 · La ventaja física</a></li>
              <li><a href="/#gabinete">03 · El inmueble</a></li>
              <li><a href="/#app-movil">04 · La app</a></li>
              <li><a href="/#post-sismo">05 · Post-sismo</a></li>
              <li><a href="/#consola">06 · Sala de operaciones</a></li>
              <li><a href="/#instalacion">07 · Configuración</a></li>
              <li><a href="/#contacto">08 · Contacto</a></li>
            </ul>
          </details>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie">
      <div class="marco pie__grid">
        <div>
          <p class="placa">
            <Image
              src={logoTakab}
              alt="TAKAB TECHNOLOGY"
              width={220}
              densities={[1, 2]}
            />
          </p>
          <p class="pie__linea">
            TAKAB Ailert es un producto de TAKAB TECHNOLOGY.
          </p>
          <p class="humo pie__linea">© {anio} TAKAB TECHNOLOGY · México</p>
        </div>
        <div>
          <h2 class="mono pie__titulo">Correo de la plataforma</h2>
          <!-- fuente: envs/dev/site/index.html (T-2.156) — declaración del dominio
               remitente; este sitio es evidencia del caso SES y la conserva. -->
          <p class="pie__linea">
            Los avisos automáticos de la plataforma se envían desde
            <strong>alertas@takabailert.com</strong>, únicamente a las personas
            que el cliente institucional registra en su consola. No enviamos
            correo promocional.
          </p>
          <p class="humo pie__linea">
            Este sitio corresponde al dominio remitente de los correos de la
            plataforma.
          </p>
        </div>
        <div>
          <h2 class="mono pie__titulo">Contacto y legal</h2>
          <ul class="pie__lista">
            <li><a href={`mailto:${CONTACTO_EMAIL}`}>{CONTACTO_EMAIL}</a></li>
            <li><a href="/aviso-de-privacidad.html">Aviso de privacidad</a></li>
          </ul>
          <p class="mono humo pie__rev">takabailert.com · rev {rev}</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .barra {
    position: sticky;
    top: 0;
    z-index: 70;
    border-bottom: 1px solid var(--linea);
    background: rgba(5, 11, 20, 0.98);
  }
  .barra__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-2) var(--e-5);
    padding-block: var(--e-4);
  }
  .barra__marca {
    display: block;
    width: clamp(150px, 18vw, 188px);
    text-decoration: none;
  }
  .barra__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3) 18px;
    list-style: none;
    padding: 0;
  }
  .barra__nav a {
    text-decoration: none;
    color: var(--texto-2);
  }
  .barra__cta {
    color: var(--cian);
  }
  .barra__nav-movil {
    display: none;
  }
  .menu-movil {
    position: relative;
  }
  .menu-movil summary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border: 1px solid var(--linea-fuerte);
    color: var(--texto-1);
    cursor: pointer;
    list-style: none;
  }
  .menu-movil summary::-webkit-details-marker {
    display: none;
  }
  .menu-movil summary i,
  .menu-movil summary i::before {
    display: block;
    width: 16px;
    height: 1px;
    background: var(--cian);
  }
  .menu-movil summary i {
    position: relative;
  }
  .menu-movil summary i::before {
    content: "";
    position: absolute;
    top: 5px;
    left: 0;
  }
  .menu-movil[open] summary {
    border-color: var(--cian);
    color: var(--cian);
  }
  .menu-movil__lista {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: grid;
    width: min(86vw, 340px);
    max-height: calc(100svh - 110px);
    overflow-y: auto;
    padding: 8px;
    border: 1px solid var(--linea-fuerte);
    background: rgba(5, 11, 20, 0.99);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.58);
    list-style: none;
  }
  .menu-movil__lista a {
    display: block;
    min-height: 44px;
    padding: 12px;
    border-bottom: 1px solid var(--linea);
    color: var(--texto-2);
    text-decoration: none;
  }
  .pie__titulo {
    color: var(--texto-3);
    margin-bottom: var(--e-3);
  }
  .pie__linea {
    margin-top: var(--e-3);
    max-width: 52ch;
  }
  .pie__lista {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--e-2);
  }
  .pie__rev {
    margin-top: var(--e-5);
  }

  @media (hover: hover) and (pointer: fine) {
    .barra__nav a:hover {
      color: var(--cian-hover);
    }
  }

  @media (max-width: 1100px) {
    .barra__fila {
      flex-wrap: nowrap;
    }
    .barra__nav-escritorio {
      display: none;
    }
    .barra__nav-movil {
      display: block;
    }
  }
</style>

<script src="../scripts/landing.ts"></script>
