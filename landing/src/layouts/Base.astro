---
// Layout raíz de la landing pública. El contrato de dirección (impeccable)
// vive como primer hijo del <body> y sobrevive al build de producción.
import "../styles/tokens.css";
import "../styles/global.css";
import { Image } from "astro:assets";
import logoTakab from "../assets/img/logo-takab-technology.png";
import sairaUrl from "../assets/fonts/saira-condensed-700.woff2?url";
import archivoUrl from "../assets/fonts/archivo-400.woff2?url";
import { CONTACTO_EMAIL } from "../config";

interface Props {
  title: string;
  description: string;
  /** Ruta servida (con .html en subpáginas): canónica = apex + path */
  path: string;
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const canonical = `https://takabailert.com${path === "/" ? "/" : path}`;
const rev = import.meta.env.PUBLIC_REV ?? "dev";
const anio = 2026;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#071322" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={sairaUrl}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={archivoUrl}
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TAKAB Ailert" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://takabailert.com/og-v2.png" />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!--
    THESIS: La landing es la sala de operaciones del producto vuelta cinematica: la identidad REAL (navy+cian de la consola) contando la fisica de la alerta, con la honestidad declarada (que hace / que NO hace) intacta como argumento.
    OWN-WORLD: Telemetria v2 — fondo navy #071322/#0E2336, cian #00BFFF como unico acento electrico con glow de senal, semaforo verde/ambar/rojo SOLO semantico, crisis #160808 de la app; Saira Condensed display, Archivo cuerpo, JetBrains Mono telemetria; paneles de consola radio 8px, hilos de luz 1px; cero glassmorphism, cero degradados morado-azul.
    STORY: El comprador siente la senal (onda del hero), entiende por que la alerta le gana a las ondas (mapa de la fisica), ve al gabinete actuar (esquema + simulacro), comprueba la consola REAL (capturas con datos de demostracion) y confia por lo que el sistema declara NO hacer.
    FIRST VIEWPORT: titular display a 3 lineas con "SOLO." en cian (elemento LCP) y el lede+CTA a su derecha en escritorio; riel de chips de estado pegado al sismograma vivo (canvas), que entra al primer viewport anclando el hero a la altura de pantalla en >=1280.
    FORM: rediseno pedido por el usuario 2026-08-25 (tecnologico/moderno/llamativo, colores de la identidad) — reemplaza al mundo Swiss Print v1; sin sorteo: direccion confirmada por 4 respuestas estructuradas.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance.
    -->
    <a class="salto" href="#contenido">Saltar al contenido</a>

    <header class="barra">
      <div class="marco barra__fila">
        <a class="barra__marca" href="/" aria-label="TAKAB Ailert — inicio">
          <span class="barra__nombre">TAKAB AILERT</span>
        </a>
        <nav aria-label="Navegación principal">
          <ul class="barra__nav mono">
            <li><a href="/#alerta-temprana">Cómo funciona</a></li>
            <li><a href="/#que-hace">Qué hace</a></li>
            <li><a class="barra__cta" href="/#contacto">Contacto</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie">
      <div class="marco pie__grid">
        <div>
          <p class="placa">
            <Image
              src={logoTakab}
              alt="TAKAB TECHNOLOGY"
              width={220}
              densities={[1, 2]}
            />
          </p>
          <p class="pie__linea">
            TAKAB Ailert es un producto de TAKAB TECHNOLOGY.
          </p>
          <p class="humo pie__linea">© {anio} TAKAB TECHNOLOGY · México</p>
        </div>
        <div>
          <h2 class="mono pie__titulo">Correo de la plataforma</h2>
          <!-- fuente: envs/dev/site/index.html (T-2.156) — declaración del dominio
               remitente; este sitio es evidencia del caso SES y la conserva. -->
          <p class="pie__linea">
            Los avisos automáticos de la plataforma se envían desde
            <strong>alertas@takabailert.com</strong>, únicamente a las personas
            que el cliente institucional registra en su consola. No enviamos
            correo promocional.
          </p>
          <p class="humo pie__linea">
            Este sitio corresponde al dominio remitente de los correos de la
            plataforma.
          </p>
        </div>
        <div>
          <h2 class="mono pie__titulo">Contacto y legal</h2>
          <ul class="pie__lista">
            <li><a href={`mailto:${CONTACTO_EMAIL}`}>{CONTACTO_EMAIL}</a></li>
            <li><a href="/aviso-de-privacidad.html">Aviso de privacidad</a></li>
          </ul>
          <p class="mono humo pie__rev">takabailert.com · rev {rev}</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .barra {
    border-bottom: 1px solid var(--linea);
    background: var(--fondo-0);
  }
  .barra__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-2) var(--e-5);
    padding-block: var(--e-4);
  }
  .barra__marca {
    text-decoration: none;
  }
  .barra__nombre {
    font-family: var(--fuente-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: 0.02em;
    color: var(--texto-1);
  }
  .barra__nombre::after {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-left: 8px;
    border-radius: 50%;
    background: var(--cian);
    box-shadow: var(--glow-cian);
    vertical-align: 0.35em;
  }
  .barra__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-4) var(--e-5);
    list-style: none;
    padding: 0;
  }
  .barra__nav a {
    text-decoration: none;
    color: var(--texto-2);
  }
  .barra__nav a:hover {
    color: var(--cian-hover);
  }
  .barra__cta {
    color: var(--cian);
  }
  .pie__titulo {
    color: var(--texto-3);
    margin-bottom: var(--e-3);
  }
  .pie__linea {
    margin-top: var(--e-3);
    max-width: 52ch;
  }
  .pie__lista {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--e-2);
  }
  .pie__rev {
    margin-top: var(--e-5);
  }
</style>

<script src="../scripts/landing.ts"></script>
