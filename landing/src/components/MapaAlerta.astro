---
// «La señal le gana a las ondas» — la física del alertamiento temprano.
// México como matriz de puntos (generada en build por point-in-polygon sobre
// un contorno simplificado), un epicentro ilustrativo frente a la costa de
// Guerrero y la CDMX: el haz de alerta llega de inmediato; los anillos de
// las ondas sísmicas tardan. SIN claims de cobertura ni sitios: es el
// principio físico, no un mapa de despliegues. Animación CSS pura
// (transform/opacity); reduced-motion = escena estática completa.

type P = [number, number]; // [lat, lon]

// Contorno simplificado (ilustrativo) — continental + Yucatán:
const MEX: P[] = [
  [32.5, -117.1],
  [32.7, -114.7],
  [31.3, -111.0],
  [31.8, -108.2],
  [31.8, -106.4],
  [29.5, -104.4],
  [29.8, -102.7],
  [28.7, -100.5],
  [26.0, -97.5],
  [23.5, -97.8],
  [21.5, -97.3],
  [20.5, -96.5],
  [18.7, -95.6],
  [18.6, -94.4],
  [18.1, -93.2],
  [18.6, -91.5],
  [19.8, -90.7],
  [21.2, -90.0],
  [21.6, -88.0],
  [21.4, -86.8],
  [19.6, -87.4],
  [18.2, -87.9],
  [17.8, -89.1],
  [17.8, -90.9],
  [16.0, -91.7],
  [14.8, -92.2],
  [15.8, -93.8],
  [16.0, -95.0],
  [15.9, -97.2],
  [16.5, -98.7],
  [17.0, -100.1],
  [18.0, -102.2],
  [18.3, -103.6],
  [19.0, -104.3],
  [20.5, -105.4],
  [21.5, -105.3],
  [22.5, -105.9],
  [23.2, -106.4],
  [24.8, -107.9],
  [25.5, -109.0],
  [27.0, -110.0],
  [27.9, -110.9],
  [29.0, -112.2],
  [30.5, -113.1],
  [31.5, -114.8],
];
// Península de Baja California:
const BAJA: P[] = [
  [32.5, -117.1],
  [31.8, -116.6],
  [30.0, -115.8],
  [28.0, -114.3],
  [27.7, -114.9],
  [26.7, -113.5],
  [24.8, -112.3],
  [23.4, -110.6],
  [22.9, -109.9],
  [23.5, -109.4],
  [24.3, -110.3],
  [25.0, -110.7],
  [26.0, -111.3],
  [27.0, -112.0],
  [28.0, -112.8],
  [29.0, -113.5],
  [30.0, -114.4],
  [31.2, -114.9],
  [32.2, -115.2],
];

const X = (lon: number) => (lon + 118.5) * 34.4;
const Y = (lat: number) => (33.5 - lat) * 32.8;

function dentro(lat: number, lon: number, poli: P[]): boolean {
  let dentro = false;
  for (let i = 0, j = poli.length - 1; i < poli.length; j = i++) {
    const [yi, xi] = poli[i]!;
    const [yj, xj] = poli[j]!;
    const cruza =
      yi > lat !== yj > lat && lon < ((xj - xi) * (lat - yi)) / (yj - yi) + xi;
    if (cruza) dentro = !dentro;
  }
  return dentro;
}

const puntos: { x: number; y: number }[] = [];
// Origen +0.05°: ninguna fila/columna cae EXACTO sobre un vértice del
// polígono (el ray-casting degenera en el borde y come bandas enteras).
for (let lat = 14.25; lat <= 33.4; lat += 0.5) {
  for (let lon = -118.45; lon <= -86.2; lon += 0.55) {
    if (dentro(lat, lon, MEX) || dentro(lat, lon, BAJA)) {
      puntos.push({ x: X(lon), y: Y(lat) });
    }
  }
}

// Epicentro ilustrativo frente a Guerrero y la CDMX:
const EPI = { x: X(-99.5), y: Y(16.7) };
const CDMX = { x: X(-99.13), y: Y(19.43) };
const dx = CDMX.x - EPI.x;
const dy = CDMX.y - EPI.y;
const LARGO = Math.hypot(dx, dy);
const ANG = (Math.atan2(dy, dx) * 180) / Math.PI;
---

<figure class="mapa" data-rv>
  <p class="oculto" id="mapa-desc">
    Diagrama animado del principio del alertamiento temprano sobre un mapa
    ilustrativo de México: un sismo frente a la costa de Guerrero emite ondas
    sísmicas que viajan por la roca durante decenas de segundos hacia la Ciudad
    de México, mientras la señal de alerta — que viaja a la velocidad de las
    telecomunicaciones — llega de inmediato. Ese margen es el que el gabinete
    usa para accionar sirena, gas, ascensores y puertas antes de la sacudida.
  </p>
  <svg
    viewBox="0 0 1120 660"
    role="img"
    aria-labelledby="mapa-desc"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- matriz de puntos del territorio -->
    <g class="m-pais">
      {
        puntos.map((p) => (
          <circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="2.3" />
        ))
      }
    </g>

    <!-- ondas sísmicas: anillos que se expanden LENTO desde el epicentro -->
    <g
      class="m-ondas"
      style={`--ex:${EPI.x.toFixed(1)}px; --ey:${EPI.y.toFixed(1)}px;`}
    >
      <circle
        class="m-anillo m-anillo--1"
        cx={EPI.x}
        cy={EPI.y}
        r="10"
        vector-effect="non-scaling-stroke"></circle>
      <circle
        class="m-anillo m-anillo--2"
        cx={EPI.x}
        cy={EPI.y}
        r="10"
        vector-effect="non-scaling-stroke"></circle>
      <circle
        class="m-anillo m-anillo--3"
        cx={EPI.x}
        cy={EPI.y}
        r="10"
        vector-effect="non-scaling-stroke"></circle>
    </g>

    <!-- haz de alerta: llega de inmediato -->
    <g
      class="m-haz"
      style={`transform-origin:${EPI.x.toFixed(1)}px ${EPI.y.toFixed(1)}px; --ang:${ANG.toFixed(1)}deg; --largo:${LARGO.toFixed(1)}px;`}
    >
      <rect
        class="m-haz__linea"
        x={EPI.x}
        y={EPI.y - 1.25}
        width={LARGO}
        height="2.5"
        rx="1.25"></rect>
      <rect
        class="m-haz__pulso"
        x={EPI.x - 4}
        y={EPI.y - 4}
        width="8"
        height="8"
        rx="2"></rect>
    </g>

    <!-- epicentro y CDMX -->
    <g class="m-epi">
      <circle class="m-epi__nucleo" cx={EPI.x} cy={EPI.y} r="6"></circle>
      <text class="m-rotulo" x={EPI.x - 14} y={EPI.y + 26} text-anchor="end"
        >EPICENTRO ILUSTRATIVO</text
      >
    </g>
    <g
      class="m-cdmx"
      style={`transform-origin:${CDMX.x.toFixed(1)}px ${CDMX.y.toFixed(1)}px;`}
    >
      <circle class="m-cdmx__halo" cx={CDMX.x} cy={CDMX.y} r="14"></circle>
      <circle class="m-cdmx__nucleo" cx={CDMX.x} cy={CDMX.y} r="5"></circle>
      <text class="m-rotulo" x={CDMX.x + 18} y={CDMX.y - 12}>CDMX</text>
    </g>
  </svg>
  <figcaption class="mapa__pie">
    <span class="mapa__leyenda"
      ><i class="mapa__punto mapa__punto--cian"></i> Señal de alerta — inmediata</span
    >
    <span class="mapa__leyenda"
      ><i class="mapa__punto mapa__punto--ambar"></i> Ondas sísmicas — kilómetros
      por segundo</span
    >
    <span class="mono humo"
      >Escena ilustrativa del principio físico · sin sitios ni cobertura</span
    >
  </figcaption>
</figure>

<style>
  .mapa {
    margin: 0;
    background:
      repeating-linear-gradient(
        90deg,
        var(--linea) 0,
        var(--linea) 1px,
        transparent 1px,
        transparent 80px
      ),
      repeating-linear-gradient(
        0deg,
        var(--linea) 0,
        var(--linea) 1px,
        transparent 1px,
        transparent 80px
      ),
      var(--fondo-1);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    padding: var(--e-5);
  }
  .mapa svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .m-pais circle {
    fill: rgba(240, 242, 245, 0.2);
  }
  .m-rotulo {
    font-family: var(--fuente-mono);
    font-size: 15px;
    letter-spacing: 0.08em;
    fill: var(--texto-2);
  }

  .m-anillo {
    fill: none;
    stroke: var(--ambar);
    stroke-width: 1.6;
    opacity: 0.5;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(6);
  }
  .m-epi__nucleo {
    fill: var(--rojo);
    filter: drop-shadow(0 0 8px rgba(255, 82, 82, 0.7));
  }
  .m-haz__linea {
    fill: var(--cian);
    filter: drop-shadow(0 0 6px rgba(0, 191, 255, 0.6));
    transform: rotate(var(--ang));
    transform-origin: inherit;
  }
  .m-haz__pulso {
    fill: var(--cian);
    opacity: 0;
    transform: rotate(var(--ang));
    transform-origin: inherit;
  }
  .m-cdmx__nucleo {
    fill: var(--cian);
    filter: drop-shadow(0 0 8px rgba(0, 191, 255, 0.8));
  }
  .m-cdmx__halo {
    fill: none;
    stroke: var(--cian);
    stroke-width: 1.5;
    opacity: 0.6;
    transform-box: fill-box;
    transform-origin: center;
  }

  /* --- Ciclo de 10 s (solo con movimiento permitido) --- */
  @media (prefers-reduced-motion: no-preference) {
    .m-anillo {
      animation: m-expande 10s linear infinite;
    }
    .m-anillo--2 {
      animation-delay: 1.1s;
    }
    .m-anillo--3 {
      animation-delay: 2.2s;
    }
    .m-haz__linea {
      animation: m-haz 10s ease-out infinite;
    }
    .m-haz__pulso {
      animation: m-pulso 10s linear infinite;
    }
    .m-cdmx__halo {
      animation: m-recibe 10s linear infinite;
    }
    .m-epi__nucleo {
      transform-box: fill-box;
      transform-origin: center;
      animation: m-late 10s linear infinite;
    }
  }
  @keyframes m-expande {
    0% {
      transform: scale(0.2);
      opacity: 0;
    }
    4% {
      opacity: 0.75;
    }
    70% {
      transform: scale(11);
      opacity: 0.14;
    }
    82%,
    100% {
      transform: scale(13);
      opacity: 0;
    }
  }
  @keyframes m-haz {
    0% {
      transform: rotate(var(--ang)) scaleX(0);
      opacity: 0;
    }
    2% {
      opacity: 1;
    }
    5%,
    88% {
      transform: rotate(var(--ang)) scaleX(1);
      opacity: 0.9;
    }
    100% {
      transform: rotate(var(--ang)) scaleX(1);
      opacity: 0;
    }
  }
  @keyframes m-pulso {
    0% {
      transform: rotate(var(--ang)) translateX(0);
      opacity: 0;
    }
    1% {
      opacity: 1;
    }
    4% {
      transform: rotate(var(--ang)) translateX(var(--largo));
      opacity: 1;
    }
    6%,
    100% {
      transform: rotate(var(--ang)) translateX(var(--largo));
      opacity: 0;
    }
  }
  @keyframes m-recibe {
    0%,
    3% {
      transform: scale(0.4);
      opacity: 0;
    }
    6% {
      transform: scale(1);
      opacity: 0.9;
    }
    12% {
      transform: scale(1.6);
      opacity: 0;
    }
    /* …las ondas llegan: segundo aviso, ahora ámbar por el halo del núcleo */
    64% {
      transform: scale(0.4);
      opacity: 0;
    }
    68% {
      transform: scale(1.4);
      opacity: 0.8;
    }
    76%,
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }
  @keyframes m-late {
    0% {
      transform: scale(1);
    }
    2% {
      transform: scale(1.8);
    }
    5%,
    100% {
      transform: scale(1);
    }
  }

  .mapa__pie {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3) var(--e-6);
    align-items: center;
    padding-top: var(--e-4);
  }
  .mapa__leyenda {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    font-family: var(--fuente-mono);
    font-size: var(--t-label);
    letter-spacing: 0.06em;
    color: var(--texto-2);
  }
  .mapa__punto {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .mapa__punto--cian {
    background: var(--cian);
    box-shadow: var(--glow-cian);
  }
  .mapa__punto--ambar {
    background: var(--ambar);
  }
  .mapa__nota {
    text-transform: none;
    letter-spacing: 0.05em;
  }
</style>
