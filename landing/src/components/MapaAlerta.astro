---
// Escena editorial del principio de detección: el evento nace en un epicentro
// ilustrativo, su frente se propaga y distintas estaciones fijas se activan al
// recibirlo. Las rutas radiales explican la relación; no representan enlaces,
// despliegues ni ubicaciones reales. Movimiento: transform/opacity y pausa fuera
// del viewport; reduced-motion conserva el estado final legible.

type P = [number, number]; // [lat, lon]

const MEX: P[] = [
  [32.5, -117.1],
  [32.7, -114.7],
  [31.3, -111.0],
  [31.8, -108.2],
  [31.8, -106.4],
  [29.5, -104.4],
  [29.8, -102.7],
  [28.7, -100.5],
  [26.0, -97.5],
  [23.5, -97.8],
  [21.5, -97.3],
  [20.5, -96.5],
  [18.7, -95.6],
  [18.6, -94.4],
  [18.1, -93.2],
  [18.6, -91.5],
  [19.8, -90.7],
  [21.2, -90.0],
  [21.6, -88.0],
  [21.4, -86.8],
  [19.6, -87.4],
  [18.2, -87.9],
  [17.8, -89.1],
  [17.8, -90.9],
  [16.0, -91.7],
  [14.8, -92.2],
  [15.8, -93.8],
  [16.0, -95.0],
  [15.9, -97.2],
  [16.5, -98.7],
  [17.0, -100.1],
  [18.0, -102.2],
  [18.3, -103.6],
  [19.0, -104.3],
  [20.5, -105.4],
  [21.5, -105.3],
  [22.5, -105.9],
  [23.2, -106.4],
  [24.8, -107.9],
  [25.5, -109.0],
  [27.0, -110.0],
  [27.9, -110.9],
  [29.0, -112.2],
  [30.5, -113.1],
  [31.5, -114.8],
];

const BAJA: P[] = [
  [32.5, -117.1],
  [31.8, -116.6],
  [30.0, -115.8],
  [28.0, -114.3],
  [27.7, -114.9],
  [26.7, -113.5],
  [24.8, -112.3],
  [23.4, -110.6],
  [22.9, -109.9],
  [23.5, -109.4],
  [24.3, -110.3],
  [25.0, -110.7],
  [26.0, -111.3],
  [27.0, -112.0],
  [28.0, -112.8],
  [29.0, -113.5],
  [30.0, -114.4],
  [31.2, -114.9],
  [32.2, -115.2],
];

const X = (lon: number) => (lon + 118.5) * 34.4;
const Y = (lat: number) => (33.5 - lat) * 32.8;

function dentro(lat: number, lon: number, poli: P[]): boolean {
  let estaDentro = false;
  for (let i = 0, j = poli.length - 1; i < poli.length; j = i++) {
    const [yi, xi] = poli[i]!;
    const [yj, xj] = poli[j]!;
    const cruza =
      yi > lat !== yj > lat && lon < ((xj - xi) * (lat - yi)) / (yj - yi) + xi;
    if (cruza) estaDentro = !estaDentro;
  }
  return estaDentro;
}

const puntos: { x: number; y: number }[] = [];
for (let lat = 14.25; lat <= 33.4; lat += 0.5) {
  for (let lon = -118.45; lon <= -86.2; lon += 0.55) {
    if (dentro(lat, lon, MEX) || dentro(lat, lon, BAJA))
      puntos.push({ x: X(lon), y: Y(lat) });
  }
}

const EPI = { x: X(-99.5), y: Y(16.7) };
const ESTACIONES = [
  { nombre: "Guerrero", lat: 16.9, lon: -99.9, delay: ".25s" },
  { nombre: "Oaxaca", lat: 17.1, lon: -96.7, delay: ".8s" },
  { nombre: "Michoacán", lat: 18.6, lon: -102.1, delay: "1.15s" },
  { nombre: "Morelos", lat: 18.75, lon: -99.25, delay: "1.7s" },
  { nombre: "Puebla", lat: 19.05, lon: -98.2, delay: "2.05s", label: true },
  { nombre: "Tlaxcala", lat: 19.32, lon: -98.24, delay: "2.3s", label: true },
  { nombre: "CDMX", lat: 19.43, lon: -99.13, delay: "2.5s", label: true },
  { nombre: "Edo. Méx.", lat: 19.35, lon: -99.6, delay: "2.65s" },
  { nombre: "Hidalgo", lat: 20.1, lon: -98.75, delay: "3.05s" },
  { nombre: "Veracruz", lat: 19.18, lon: -96.14, delay: "3.3s" },
].map((e) => {
  const x = X(e.lon);
  const y = Y(e.lat);
  const dx = x - EPI.x;
  const dy = y - EPI.y;
  return {
    ...e,
    x,
    y,
    largo: Math.hypot(dx, dy),
    angulo: (Math.atan2(dy, dx) * 180) / Math.PI,
  };
});
---

<figure class="mapa" data-rv data-instrumento>
  <p class="oculto" id="mapa-desc">
    Diagrama animado e ilustrativo de México. Ondas rojas, naranjas y ámbar
    avanzan desde un epicentro frente a Guerrero. Líneas radiales recorren el
    mapa hasta estaciones fijas en Guerrero, Oaxaca, Michoacán, Morelos, Puebla,
    Tlaxcala, Ciudad de México, Estado de México, Hidalgo y Veracruz. Cada
    estación cambia de color cuando el frente la alcanza.
  </p>
  <svg
    viewBox="0 0 1120 660"
    role="img"
    aria-labelledby="mapa-desc"
    xmlns="http://www.w3.org/2000/svg"
  >
    <g class="m-pais">
      {
        puntos.map((p) => (
          <circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="2.3" />
        ))
      }
    </g>

    <!-- Todas las rutas nacen en el epicentro. El trazo crece; ningún nodo viaja. -->
    <g class="m-rutas" aria-hidden="true">
      {
        ESTACIONES.map((e) => (
          <g
            class="m-ruta"
            style={`transform-origin:${EPI.x.toFixed(1)}px ${EPI.y.toFixed(1)}px; --ang:${e.angulo.toFixed(1)}deg; --delay:${e.delay};`}
          >
            <rect
              class="m-ruta__base"
              x={EPI.x.toFixed(1)}
              y={(EPI.y - 0.75).toFixed(1)}
              width={e.largo.toFixed(1)}
              height="1.5"
              rx=".75"
            />
            <rect
              class="m-ruta__flujo"
              x={EPI.x.toFixed(1)}
              y={(EPI.y - 1.35).toFixed(1)}
              width={e.largo.toFixed(1)}
              height="2.7"
              rx="1.35"
            />
          </g>
        ))
      }
    </g>

    <!-- Tres frentes, con color distinto según su cercanía al origen. -->
    <g
      class="m-ondas"
      style={`--ex:${EPI.x.toFixed(1)}px; --ey:${EPI.y.toFixed(1)}px;`}
      aria-hidden="true"
    >
      <circle
        class="m-anillo m-anillo--cercano"
        cx={EPI.x}
        cy={EPI.y}
        r="10"
        vector-effect="non-scaling-stroke"></circle>
      <circle
        class="m-anillo m-anillo--medio"
        cx={EPI.x}
        cy={EPI.y}
        r="10"
        vector-effect="non-scaling-stroke"></circle>
      <circle
        class="m-anillo m-anillo--lejano"
        cx={EPI.x}
        cy={EPI.y}
        r="10"
        vector-effect="non-scaling-stroke"></circle>
    </g>

    <!-- El grupo nunca cambia de posición: solo aparece la capa activa. -->
    <g class="m-estaciones">
      {
        ESTACIONES.map((e, i) => (
          <g
            class={`m-estacion m-estacion--${i + 1}`}
            style={`--delay:${e.delay};`}
          >
            <circle
              class="m-estacion__halo"
              cx={e.x.toFixed(1)}
              cy={e.y.toFixed(1)}
              r="12"
            />
            <rect
              class="m-estacion__nodo"
              x={(e.x - 5).toFixed(1)}
              y={(e.y - 5).toFixed(1)}
              width="10"
              height="10"
              rx="2"
            />
            <path
              class="m-estacion__antena"
              d={`M${e.x.toFixed(1)} ${(e.y - 5).toFixed(1)}v-9m-5 4a7 7 0 0 1 10 0`}
            />
            <circle
              class="m-estacion__activo m-estacion__activo--halo"
              cx={e.x.toFixed(1)}
              cy={e.y.toFixed(1)}
              r="13"
            />
            <rect
              class="m-estacion__activo m-estacion__activo--nodo"
              x={(e.x - 5).toFixed(1)}
              y={(e.y - 5).toFixed(1)}
              width="10"
              height="10"
              rx="2"
            />
            <path
              class="m-estacion__activo m-estacion__activo--antena"
              d={`M${e.x.toFixed(1)} ${(e.y - 5).toFixed(1)}v-9m-5 4a7 7 0 0 1 10 0`}
            />
            {e.label && (
              <text
                class="m-rotulo m-rotulo--estacion"
                x={(e.x + (e.nombre === "CDMX" ? -18 : 18)).toFixed(1)}
                y={(e.y + (e.nombre === "Tlaxcala" ? 30 : -17)).toFixed(1)}
                text-anchor={e.nombre === "CDMX" ? "end" : "start"}
              >
                {e.nombre.toUpperCase()}
              </text>
            )}
          </g>
        ))
      }
    </g>

    <g class="m-epi">
      <circle class="m-epi__nucleo" cx={EPI.x} cy={EPI.y} r="6"></circle>
      <text class="m-rotulo" x={EPI.x - 14} y={EPI.y + 26} text-anchor="end"
        >EPICENTRO ILUSTRATIVO</text
      >
    </g>
  </svg>

  <figcaption class="mapa__pie">
    <span class="mapa__leyenda"
      ><i class="mapa__punto mapa__punto--cian"></i> Flujo hacia cada estación</span
    >
    <span class="mapa__leyenda"
      ><i class="mapa__punto mapa__punto--onda"></i> Ondas: cercanía al epicentro</span
    >
    <span class="mono humo"
      >Estaciones y ubicaciones ilustrativas · no representan cobertura
      desplegada</span
    >
  </figcaption>
</figure>

<style>
  .mapa {
    margin: 0;
    padding: var(--e-5);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background:
      repeating-linear-gradient(
        90deg,
        var(--linea) 0,
        var(--linea) 1px,
        transparent 1px,
        transparent 80px
      ),
      repeating-linear-gradient(
        0deg,
        var(--linea) 0,
        var(--linea) 1px,
        transparent 1px,
        transparent 80px
      ),
      var(--fondo-1);
  }
  .mapa svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .m-pais circle {
    fill: rgba(240, 242, 245, 0.2);
  }
  .m-rotulo {
    fill: var(--texto-2);
    font-family: var(--fuente-mono);
    font-size: 15px;
    letter-spacing: 0.08em;
  }
  .m-rotulo--estacion {
    fill: var(--texto-1);
    font-size: 12px;
  }
  .m-epi__nucleo {
    fill: var(--rojo);
    filter: drop-shadow(0 0 8px rgba(255, 45, 26, 0.7));
    transform-box: fill-box;
    transform-origin: center;
  }

  .m-ruta {
    transform: rotate(var(--ang));
    transform-box: view-box;
  }
  .m-ruta__base,
  .m-ruta__flujo {
    transform-origin: left center;
  }
  .m-ruta__base {
    fill: rgba(106, 168, 255, 0.14);
  }
  .m-ruta__flujo {
    fill: var(--cian);
    opacity: 0.76;
    filter: drop-shadow(0 0 5px rgba(106, 168, 255, 0.58));
  }

  .m-anillo {
    fill: none;
    stroke-width: 1.7;
    opacity: 0.42;
    transform-box: fill-box;
    transform-origin: center;
  }
  .m-anillo--cercano {
    --escala: 4.8;
    stroke: var(--rojo);
    transform: scale(4.8);
  }
  .m-anillo--medio {
    --escala: 8.4;
    stroke: #ff7a3d;
    transform: scale(8.4);
  }
  .m-anillo--lejano {
    --escala: 13;
    stroke: var(--ambar);
    transform: scale(13);
  }

  .m-estacion__halo {
    fill: none;
    stroke: var(--texto-3);
    stroke-width: 1.2;
    opacity: 0.3;
  }
  .m-estacion__nodo {
    fill: var(--fondo-0);
    stroke: var(--texto-3);
    stroke-width: 1.4;
  }
  .m-estacion__antena {
    fill: none;
    stroke: var(--texto-3);
    stroke-width: 1.2;
  }
  .m-estacion__activo {
    opacity: 0;
  }
  .m-estacion__activo--halo {
    fill: none;
    stroke: var(--ambar);
    stroke-width: 1.8;
    filter: drop-shadow(0 0 7px rgba(255, 193, 7, 0.72));
  }
  .m-estacion__activo--nodo {
    fill: var(--ambar);
  }
  .m-estacion__activo--antena {
    fill: none;
    stroke: var(--ambar);
    stroke-width: 1.8;
    filter: drop-shadow(0 0 5px rgba(255, 193, 7, 0.72));
  }

  @media (prefers-reduced-motion: no-preference) {
    .m-ruta__flujo {
      animation: m-flujo 10s var(--ease-out) infinite;
      animation-delay: var(--delay);
    }
    .m-anillo {
      animation: m-expande 10s linear infinite;
    }
    .m-anillo--medio {
      animation-delay: 0.95s;
    }
    .m-anillo--lejano {
      animation-delay: 1.9s;
    }
    .m-estacion__activo {
      animation: m-detectada 10s linear infinite;
      animation-delay: calc(var(--delay) + 0.72s);
    }
    .m-epi__nucleo {
      animation: m-late 10s linear infinite;
    }
    .mapa.pausado * {
      animation-play-state: paused !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .m-estacion__activo {
      opacity: 0.86;
    }
  }
  @keyframes m-flujo {
    0% {
      opacity: 0;
      transform: scaleX(0);
    }
    2% {
      opacity: 1;
    }
    9%,
    62% {
      opacity: 0.78;
      transform: scaleX(1);
    }
    82%,
    100% {
      opacity: 0;
      transform: scaleX(1);
    }
  }
  @keyframes m-expande {
    0% {
      opacity: 0;
      transform: scale(0.18);
    }
    5% {
      opacity: 0.82;
    }
    64% {
      opacity: 0.34;
      transform: scale(var(--escala));
    }
    78%,
    100% {
      opacity: 0;
      transform: scale(var(--escala));
    }
  }
  @keyframes m-detectada {
    0%,
    5% {
      opacity: 0;
    }
    8%,
    58% {
      opacity: 0.96;
    }
    75%,
    100% {
      opacity: 0;
    }
  }
  @keyframes m-late {
    0%,
    100% {
      transform: scale(1);
    }
    3% {
      transform: scale(1.7);
    }
    7% {
      transform: scale(1);
    }
  }

  .mapa__pie {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3) var(--e-6);
    align-items: center;
    padding-top: var(--e-4);
  }
  .mapa__leyenda {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    color: var(--texto-2);
    font-family: var(--fuente-mono);
    font-size: var(--t-label);
    letter-spacing: 0.06em;
  }
  .mapa__punto {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .mapa__punto--cian {
    background: var(--cian);
    box-shadow: var(--glow-cian);
  }
  .mapa__punto--onda {
    background: var(--rojo);
    box-shadow:
      7px 0 #ff7a3d,
      14px 0 var(--ambar);
    margin-right: 14px;
  }
</style>
