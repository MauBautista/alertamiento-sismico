<style>
  .esquema {
    margin: 0;
    padding-block: var(--e-6);
  }
  /* Las reglas del <svg> raíz (display/width y el swap responsive) viven en
     global.css: el svg no recibe el atributo de scope de Astro, y una regla
     scoped de mayor especificidad aquí pisaría el display:none del swap
     (defecto cazado dos veces en la inspección visual). */
  .esquema__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-4) var(--e-5);
    padding-top: var(--e-5);
  }
  .esquema__pie p {
    max-width: 44ch;
    text-transform: none;
    letter-spacing: 0.04em;
  }

  /* --- Piezas --- */
  .q-marco {
    fill: none;
    stroke: var(--regla);
    stroke-width: 1;
  }
  .q-caja {
    fill: var(--papel);
    stroke: var(--tinta);
    stroke-width: 1.5;
  }
  .q-caja--vital {
    stroke-width: 2.5;
  }
  .q-caja--cerebro {
    stroke-width: 2.5;
  }
  .q-caja--coord {
    stroke-width: 1;
    stroke: var(--humo);
  }
  .q-hilo {
    fill: var(--tinta);
  }
  .q-hilo--fino {
    fill: var(--humo);
  }
  .q-dash {
    stroke: var(--humo);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }
  .q-pulso {
    fill: var(--alerta);
    opacity: 0;
  }
  text {
    font-family: var(--fuente-mono);
    fill: var(--tinta);
    letter-spacing: 0.06em;
  }
  .q-t0 {
    font-size: 14px;
    font-weight: 700;
  }
  .q-t1 {
    font-size: 11px;
  }
  .q-t2 {
    font-size: 9.5px;
    fill: var(--humo);
  }
  .q-t3 {
    font-size: 9.5px;
    fill: var(--humo);
  }
  .q-t4 {
    font-size: 10px;
  }
  .q-est {
    font-size: 9px;
  }
  .q-est-off {
    fill: var(--humo);
  }
  .q-est-on {
    fill: var(--alerta);
    font-weight: 700;
    opacity: 0;
  }

  /* Estado estático activado (modo reduced-motion, conmutado por el botón) */
  .esquema.estatico-activado .q-est-off {
    opacity: 0;
  }
  .esquema.estatico-activado .q-est-on {
    opacity: 1;
  }

  /* --- Coreografía (solo transform/opacity; base = todo visible) --- */
  @media (prefers-reduced-motion: no-preference) {
    .esquema.play .q-marco {
      animation: q-aparece 300ms ease-out both;
    }
    .esquema.play .q-coord {
      animation: q-aparece 400ms ease-out 0.9s both;
    }
    .esquema.play .q-nodo {
      transform-box: fill-box;
      transform-origin: center;
      animation: q-nodo 400ms ease-out both;
      animation-delay: var(--d, 0s);
    }
    .esquema.play .q-hilo--v {
      transform-box: fill-box;
      transform-origin: top;
      animation: q-traza-v 300ms ease-out both;
      animation-delay: var(--d, 0s);
    }
    .esquema.play .q-hilo--h {
      transform-box: fill-box;
      transform-origin: left;
      animation: q-traza-h 300ms ease-out both;
      animation-delay: var(--d, 0s);
    }
    .esquema.play .q-pulso--v {
      animation: q-pulso-v 500ms linear both;
      animation-delay: var(--d, 0s);
    }
    .esquema.play .q-pulso--h {
      animation: q-pulso-h 500ms linear both;
      animation-delay: var(--d, 0s);
    }
    .esquema.play .q-est-off {
      animation: q-apaga 250ms ease-out 2.4s both;
    }
    .esquema.play .q-est-on {
      animation: q-enciende 250ms ease-out 2.4s both;
    }
    /* Reposo: el latido del cerebro, cada 4 s, tras la secuencia */
    .esquema.play .q-late {
      animation-name: q-nodo, q-latido;
      animation-duration: 400ms, 4s;
      animation-timing-function: ease-out, ease-in-out;
      animation-delay: var(--d, 0s), 3.2s;
      animation-iteration-count: 1, infinite;
      animation-fill-mode: both, none;
      transform-box: fill-box;
      transform-origin: center;
    }
  }

  @keyframes q-aparece {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes q-nodo {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes q-traza-v {
    from {
      transform: scaleY(0);
    }
    to {
      transform: none;
    }
  }
  @keyframes q-traza-h {
    from {
      transform: scaleX(0);
    }
    to {
      transform: none;
    }
  }
  @keyframes q-pulso-v {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    8% {
      opacity: 1;
    }
    92% {
      opacity: 1;
      transform: translateY(60px);
    }
    100% {
      opacity: 0;
      transform: translateY(60px);
    }
  }
  @keyframes q-pulso-h {
    0% {
      opacity: 0;
      transform: translateX(0);
    }
    8% {
      opacity: 1;
    }
    92% {
      opacity: 1;
      transform: translateX(160px);
    }
    100% {
      opacity: 0;
      transform: translateX(160px);
    }
  }
  @keyframes q-apaga {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  @keyframes q-enciende {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes q-latido {
    0% {
      transform: scale(1);
    }
    4% {
      transform: scale(1.045);
    }
    9% {
      transform: scale(1);
    }
    100% {
      transform: scale(1);
    }
  }
</style>
