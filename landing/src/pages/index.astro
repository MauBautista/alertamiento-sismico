---
// Página principal. Cada afirmación lleva su fuente anotada en un comentario
// (perímetro: CONSULTA-LEGAL-TAKAB.md §2-§3 · ENTREGA-Y-ACEPTACION-TAKAB.md).
// Invariantes del copy: CERO cifras (decisión 2026-08-25), cero normas, cero
// clientes, cero badges de tiendas, cero canales de aviso prometidos.
import Base from "../layouts/Base.astro";
import Esquema from "../components/Esquema.astro";
import { CONTACTO_EMAIL, WHATSAPP_URL } from "../config";
---

<Base
  title="TAKAB Ailert · Alertamiento sísmico que actúa en su edificio"
  description="El gabinete TAKAB recibe la alerta sísmica oficial (SASMEX) y acciona el equipamiento de su inmueble sin depender de internet. Para Protección Civil, hospitales, universidades, industria y corporativos en México."
  path="/"
>
  <!-- ═══ PORTADA ═══ -->
  <section class="hero cruz" aria-label="Portada">
    <div class="marco">
      <p class="mono humo hero__meta al" style="--d:.45s">
        <span>takabailert.com · México</span>
        <span class="hero__meta-sep" aria-hidden="true"></span>
        <span>Alertamiento sísmico · Continuidad operativa</span>
      </p>
      <div class="hero__marcador al" style="--d:.4s" aria-hidden="true"></div>
      <div class="hero__cuerpo">
        <!-- fuente: ESPECIFICACION-PANEL-GABINETE §0 «El gabinete se protege solo» /
             ENTREGA §1 «el edificio sigue protegido» -->
        <h1 class="hero__titulo">
          <span class="hero__linea al-t" style="--d:0s">El edificio</span>
          <span class="hero__linea al-t" style="--d:.07s">se protege</span>
          <span class="hero__linea al-t" style="--d:.14s">solo.</span>
        </h1>
        <div class="hero__lateral">
          <!-- fuente: CONSULTA-LEGAL §1 (definición y segmentos) + §2.2 (sin internet/nube/IA) -->
          <p class="hero__sub al" style="--d:.5s">
            TAKAB Ailert recibe la alerta sísmica oficial y acciona el
            equipamiento de su inmueble en el acto —
            <strong
              >sin depender de internet, de la nube ni de inteligencia
              artificial</strong
            >. Alertamiento, monitoreo estructural y continuidad operativa
            post-sismo para Protección Civil, hospitales, universidades,
            industria y corporativos en México.
          </p>
          <p class="hero__cta al" style="--d:.6s">
            <a class="btn btn--primario" href={`mailto:${CONTACTO_EMAIL}`}
              >Solicitar cotización</a
            >
            <a class="btn" href="#como-funciona">Ver cómo funciona</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SEC 01 · CÓMO FUNCIONA ═══ -->
  <section class="seccion" id="como-funciona">
    <div class="marco">
      <header data-rv>
        <p class="cajetin__meta mono">
          <span>SEC 01 / 07</span>
          <span>TAKAB Ailert · documento público</span>
        </p>
        <h2 class="titulo">Cuando suena la alerta</h2>
      </header>
      <div class="seccion__cuerpo">
        <div class="prosa">
          <!-- fuente: ENTREGA §2.1 (recepción WR-1 y actuación; lista de canales) -->
          <p>
            La alerta sísmica oficial en México la emite el <strong
              >SASMEX</strong
            >. El gabinete TAKAB instalado en su edificio la recibe por un
            receptor dedicado
            <strong>WR-1</strong> — un contacto eléctrico, no una conexión a internet
            — y acciona el equipamiento del inmueble en el acto. El gabinete gobierna
            cinco canales: sirena y estrobo, válvula de gas, ascensores y retenedores
            de puerta. <strong
              >Cuáles quedan conectados y acreditados lo fija la puesta en
              marcha de cada edificio, canal por canal</strong
            >.
          </p>
          <!-- fuente: CONSULTA-LEGAL §2.2 («no hay internet, no hay nube y no hay IA»;
               cualitativo por decisión 2026-08-25: sin cifras) -->
          <p>
            Del contacto de SASMEX al relé del edificio no hay internet, no hay
            nube y no hay inteligencia artificial: es una cadena eléctrica y de
            software dentro del propio gabinete, medida en milisegundos.
          </p>
        </div>

        <Esquema />

        <!-- fuente: envs/dev/site/index.html (T-2.156) — deslinde SASMEX, fórmula
             conservada del sitio desplegado; es perímetro legal, no adorno. -->
        <p class="nota-limite" data-rv>
          <span class="mono">Sobre el origen de las alertas</span>
          La alerta sísmica oficial en México es emitida por el SASMEX. TAKAB Ailert
          la recibe y actúa sobre el inmueble; <strong
            >no la genera ni la sustituye</strong
          >, y no representa a la autoridad que la emite.
        </p>

        <div class="dato-grid">
          <div>
            <!-- fuente: ENTREGA §2.4 (etiqueta literal del panel; ámbar a propósito) -->
            <h3 class="subtitulo">¿Y si se corta internet?</h3>
            <p>
              El gabinete sigue detectando, accionando y guardando. El panel del
              edificio lo dice tal cual: <strong
                >«SIN ENLACE — PROTECCIÓN LOCAL ACTIVA»</strong
              > — y lo dice en ámbar, no en rojo, porque es el sistema funcionando
              como fue diseñado. La nube coordina; nunca es requisito de la protección
              local.
            </p>
          </div>
          <div>
            <!-- fuente: ENTREGA §2.1 / blueprint §4.7 (estado seguro por canal) -->
            <h3 class="subtitulo">¿Y si algo falla?</h3>
            <p>
              Cada canal tiene un estado seguro de fábrica: una falla no deja la
              sirena sonando, <strong>cierra</strong> el gas y <strong
                >libera</strong
              > las puertas. El modo de falla se elige para proteger, no para aparentar.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SEC 02 · QUÉ HACE / QUÉ NO HACE ═══ -->
  <section class="seccion" id="que-hace">
    <div class="marco">
      <header data-rv>
        <p class="cajetin__meta mono">
          <span>SEC 02 / 07</span>
          <span>alcance declarado, también en negativo</span>
        </p>
        <h2 class="titulo">Qué hace y qué no hace</h2>
      </header>
      <div class="seccion__cuerpo">
        <p class="prosa">
          Un sistema que acciona el gas y las puertas de un edificio ocupado no
          puede venderse con promesas elásticas. Esto es lo que el sistema hace
          — y lo que declara, por escrito, que no hace.
          <!-- fuente: ENTREGA Parte II §4 («lo que este documento declara que el sistema no
               hace no es un defecto: es alcance») -->
        </p>

        <div class="spec" data-rv>
          <div>
            <h3 class="subtitulo">Hace</h3>
            <ul class="lista-regla">
              <!-- fuente: ENTREGA §2.1 -->
              <li>
                Recibe la alerta oficial <strong>SASMEX</strong> por contacto seco
                y acciona los canales conectados en su edificio: sirena y estrobo,
                y —donde se acrediten— válvula de gas, ascensores y retenedores de
                puerta.
              </li>
              <!-- fuente: ENTREGA §2.2 (detección instrumental propia; T-2.32 solo aviso) -->
              <li>
                Mide el movimiento con instrumentación propia en el edificio y
                eleva un
                <strong>aviso</strong> al panel y al centro de operaciones.
              </li>
              <!-- fuente: ENTREGA §2.4 (opera sin enlace) -->
              <li>
                Opera <strong>sin internet</strong>: detecta, acciona y guarda
                con el enlace caído, y sincroniza al volver — sin duplicar nada.
              </li>
              <!-- fuente: CONSULTA-LEGAL §2.5 (append-only, exento de retención) -->
              <li>
                Conserva la evidencia de cada evento en un registro
                <strong>que no se puede reescribir</strong>, garantizado por la
                base de datos.
              </li>
              <!-- fuente: ENTREGA §3.2 (quórum ≥3, comando firmado) -->
              <li>
                En red, corrobora con un <strong>quórum de ≥3 inmuebles</strong> y
                actúa por comando firmado, verificado por cada gabinete.
              </li>
              <!-- fuente: ENTREGA §3.4 (RLS default-deny) -->
              <li>
                Aísla los datos de cada cliente <strong
                  >en la base de datos</strong
                >: una lectura cruzada devuelve cero filas.
              </li>
            </ul>
          </div>
          <div>
            <h3 class="subtitulo subtitulo--no">No hace</h3>
            <ul class="lista-regla">
              <!-- fuente: ENTREGA §4 I-1/I-2 · RBAC §8 · CONSULTA-LEGAL §2.1 -->
              <li>
                No muestra <strong>cuenta regresiva ni magnitud</strong>: el
                receptor oficial entrega un sí o un no, y el sistema no muestra
                lo que no tiene.
              </li>
              <!-- fuente: CONSULTA-LEGAL §2.3 (IA sin campo para veredicto) -->
              <li>
                No deja que la <strong>inteligencia artificial</strong> dispare ni
                vete una alerta: la estructura de datos no tiene campo donde poner
                ese veredicto.
              </li>
              <!-- fuente: CONSULTA-LEGAL §2.4 (una estación sola no evacúa) -->
              <li>
                No evacúa a nadie por la lectura de <strong
                  >una sola estación</strong
                >: eso produce un aviso. La actuación autónoma es una decisión
                del cliente, registrada.
              </li>
              <!-- fuente: ENTREGA §6.1 («TAKAB no genera la alerta sísmica oficial») -->
              <li>
                No predice sismos ni genera la alerta oficial: la <strong
                  >recibe</strong
                >.
              </li>
              <!-- fuente: ENTREGA §6.1 (límite de responsabilidad del dictamen) -->
              <li>
                No sustituye la <strong>evaluación estructural formal</strong> ni
                autoriza el reingreso al inmueble: eso lo firma ingeniería.
              </li>
              <!-- fuente: ENTREGA §6.1 (plan de emergencia y brigada son del cliente) -->
              <li>
                No reemplaza el <strong>plan de emergencia</strong> ni a la brigada:
                sin personas entrenadas, una sirena suena en un edificio que no sabe
                qué hacer.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- fuente: CONSULTA-LEGAL §2.1 / ENTREGA §4 — mensaje literal e íntegro al ocupante.
         Banda ESTÁTICA a propósito: es una cita del producto, no teatro. -->
    <div
      class="banner-alerta"
      role="img"
      aria-label="Mensaje literal del sistema al ocupante: Alerta sísmica, protéjase"
    >
      <div class="marco">
        <strong aria-hidden="true">Alerta sísmica · Protéjase</strong>
        <p class="mono">
          El mensaje íntegro al ocupante. Sin cuenta regresiva y sin magnitud:
          quien promete ese número con un receptor de contacto seco, promete lo
          que no tiene.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ SEC 03 · DESPUÉS DEL SISMO ═══ -->
  <section class="seccion" id="despues">
    <div class="marco">
      <header data-rv>
        <p class="cajetin__meta mono">
          <span>SEC 03 / 07</span>
          <span>continuidad operativa</span>
        </p>
        <h2 class="titulo">Después del sismo</h2>
      </header>
      <div class="seccion__cuerpo">
        <p class="prosa">
          El sismo termina y empieza la pregunta que de verdad cuesta dinero y
          riesgo:
          <strong>¿se puede volver a entrar?</strong> El sistema sostiene ese proceso
          con registro, no con memoria.
        </p>
        <ul class="lista-regla lista-regla--tres">
          <!-- fuente: CONSULTA-LEGAL §2.5 -->
          <li>
            <h3 class="subtitulo">Evidencia inalterable</h3>
            <p>
              El registro sísmico del evento, las fotos y las notas quedan en un
              expediente
              <strong>que solo crece</strong>: la propia base de datos rechaza
              borrados y reescrituras, y esa evidencia está exenta de las
              políticas de retención.
            </p>
          </li>
          <!-- fuente: CONSULTA-LEGAL §2.5 / ENTREGA §3.1 (dictamen con base y firma) -->
          <li>
            <h3 class="subtitulo">Dictamen con firma</h3>
            <p>
              El dictamen operativo queda con su base y su firma. Una corrección
              <strong>nunca reescribe</strong>: inserta una versión nueva que
              declara a cuál sustituye. Todo exportable por incidente.
            </p>
          </li>
          <!-- fuente: USER-STORIES US-10 (check-in de vida) / CONSULTA-LEGAL §2.7 -->
          <li>
            <h3 class="subtitulo">Pase de lista</h3>
            <p>
              Quién está a salvo y quién necesita ayuda, por zona del inmueble —
              el dato que orienta a la brigada cuando más ruido hay.
            </p>
          </li>
        </ul>
        <!-- fuente: ENTREGA §6.1 — «límite de responsabilidad, no letra pequeña» -->
        <p class="nota-limite" data-rv>
          <span class="mono">Límite declarado</span>
          El dictamen es operativo y preliminar. No sustituye la evaluación estructural
          formal ni autoriza el reingreso al inmueble: el reingreso lo autoriza una
          firma de ingeniería.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ SEC 04 · LA RED ═══ -->
  <section class="seccion" id="red">
    <div class="marco">
      <header data-rv>
        <p class="cajetin__meta mono">
          <span>SEC 04 / 07</span>
          <span>quórum · consola · aislamiento</span>
        </p>
        <h2 class="titulo">Un edificio protege. Una red corrobora.</h2>
      </header>
      <div class="seccion__cuerpo">
        <div class="dato-grid">
          <div>
            <!-- fuente: ENTREGA §3.2 / blueprint §4.5 (quórum ≥3; comando firmado) -->
            <h3 class="subtitulo">Quórum de la red</h3>
            <p>
              Un edificio que vibra puede ser un camión. <strong
                >Tres o más inmuebles</strong
              >
              sacudiéndose a la vez, no. Cuando el quórum de la red lo confirma, la
              nube emite un <strong>comando de actuación firmado</strong> que cada
              gabinete verifica antes de mover un relé. La corroboración viaja por
              la red; la protección de cada edificio nunca depende de ella.
            </p>
          </div>
          <div>
            <!-- fuente: ENTREGA §3.3-§3.4 (consola SOC; RLS) -->
            <h3 class="subtitulo">Consola de operaciones</h3>
            <p>
              El centro de operaciones ve el mapa, la flota de gabinetes, los
              incidentes y el historial de triage — con los datos de cada
              cliente
              <strong>aislados en la base de datos</strong>, no por cortesía del
              software. La app móvil acompaña a ocupantes y brigadistas durante
              y después del evento.
            </p>
          </div>
        </div>
        <!-- fuente: ENTREGA §2.3 / §3.3 (honestidad del dato: S/D, nunca un dato viejo
             pintado como vivo). Autoexigencia que también aplica a esta página: por eso
             aquí no hay capturas simuladas ni contadores decorativos. -->
        <p class="nota-limite" data-rv>
          <span class="mono">Regla de la casa</span>
          El sistema no pinta un dato viejo como si fuera de ahora: una medición vencida
          se retira en vez de congelarse en verde. Esta página sigue la misma regla
          — no verá aquí capturas simuladas ni números de marketing.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ SEC 05 · PARA QUIÉN ═══ -->
  <section class="seccion" id="para-quien">
    <div class="marco">
      <header data-rv>
        <p class="cajetin__meta mono">
          <span>SEC 05 / 07</span>
          <span>segmentos</span>
        </p>
        <h2 class="titulo">Para quién es</h2>
      </header>
      <div class="seccion__cuerpo">
        <!-- fuente: CONSULTA-LEGAL §1 (segmentos literales); necesidades derivadas de
             USER-STORIES (épicas 1-4) y ENTREGA §2-§3 -->
        <table class="tabla">
          <thead>
            <tr>
              <th scope="col">Inmueble</th>
              <th scope="col">Lo que resuelve</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Protección Civil y gobierno</strong></td>
              <td>
                Cobertura de inmuebles públicos con evidencia auditable de cada
                evento y de cada actuación.
              </td>
            </tr>
            <tr>
              <td><strong>Hospitales</strong></td>
              <td>
                Cierre de gas y retorno de ascensores sin depender de que
                alguien esté frente a una pantalla; continuidad de la operación
                clínica después del sismo.
              </td>
            </tr>
            <tr>
              <td><strong>Universidades</strong></td>
              <td>
                Campus de muchos edificios: red de estaciones, corroboración por
                quórum y pase de lista por zona.
              </td>
            </tr>
            <tr>
              <td><strong>Industria</strong></td>
              <td>
                Paro seguro: válvulas y accesos con estado seguro por canal ante
                cualquier falla, y registro para el análisis posterior.
              </td>
            </tr>
            <tr>
              <td><strong>Corporativos</strong></td>
              <td>
                La decisión de reocupación documentada: evidencia inalterable y
                dictamen versionado para el responsable del inmueble.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ═══ SEC 06 · QUÉ SE INSTALA ═══ -->
  <section class="seccion" id="instalacion">
    <div class="marco">
      <header data-rv>
        <p class="cajetin__meta mono">
          <span>SEC 06 / 07</span>
          <span>un gabinete por edificio</span>
        </p>
        <h2 class="titulo">Qué se instala</h2>
      </header>
      <div class="seccion__cuerpo">
        <div class="dato-grid">
          <div>
            <!-- fuente: ENTREGA §2 / blueprint §4.1 (composición del gabinete);
                 «homologado» aplicado al WR-1: CONSULTA-LEGAL §2.1 -->
            <p>
              Un <strong>gabinete por edificio</strong>: receptor SASMEX WR-1
              homologado, sensor sísmico propio, cerebro local, relés con estado
              seguro por canal, respaldo de energía y almacenamiento local. Se
              conecta al equipamiento existente del inmueble — sirena, válvula
              de gas, ascensores, retenedores de puerta.
            </p>
          </div>
          <div>
            <!-- fuente: RUNBOOK-ALTA-DE-ESTACION (alta guiada); ENTREGA §6.2 (gates por
                 sitio: la acreditación es en el inmueble, canal por canal) -->
            <p>
              Cada canal —y el respaldo de energía— se acredita en el inmueble
              antes de entrar en servicio: lo que no se haya probado en su
              edificio, no se da por hecho.
            </p>
            <p>
              La instalación se da de alta con un procedimiento guiado y
              <strong
                >la puesta en marcha se acredita en sitio, canal por canal</strong
              >, con su registro. Sin precios de lista: cada inmueble se cotiza
              por su equipamiento y su cobertura.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SEC 07 · CONTACTO ═══ -->
  <section class="seccion" id="contacto">
    <div class="marco">
      <header data-rv>
        <p class="cajetin__meta mono">
          <span>SEC 07 / 07</span>
          <span>siguiente paso</span>
        </p>
        <h2 class="titulo">Hablemos de su inmueble</h2>
      </header>
      <div class="seccion__cuerpo">
        <p class="prosa">
          Escríbanos con el tipo de inmueble, la ciudad y qué necesita proteger.
          Respondemos con los siguientes pasos y una cotización a la medida.
        </p>
        <p class="hero__cta">
          <a class="btn btn--primario" href={`mailto:${CONTACTO_EMAIL}`}
            >{CONTACTO_EMAIL}</a
          >
          {
            WHATSAPP_URL && (
              <a class="btn" href={WHATSAPP_URL} rel="noopener">
                WhatsApp
              </a>
            )
          }
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- Portada --- */
  .hero {
    border-bottom: var(--borde) solid var(--tinta);
    padding-block: var(--e-7) var(--e-8);
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-3) var(--e-4);
    padding-bottom: var(--e-6);
  }
  .hero__meta-sep {
    flex: 1;
    min-width: 40px;
    border-top: var(--hilo) solid var(--regla);
  }
  /* (El nowrap va SOLO en el folio del cajetín — global.css. Aplicarlo a los
     chips del hero desborda 360: el tracking de .08em suma ~1px por carácter
     y el chip de 44ch pasa de 360. Lo cazó el assert de overflow del E2E.) */
  .hero__marcador {
    width: 56px;
    height: 14px;
    background: var(--alerta);
    margin-bottom: var(--e-5);
  }
  .hero__titulo {
    font-family: var(--fuente-display);
    font-weight: 700;
    font-size: var(--t-display);
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .hero__linea {
    display: block;
  }
  .hero__sub {
    max-width: 58ch;
    margin-top: var(--e-6);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-4);
    margin-top: var(--e-6);
  }
  /* ≥1280: composición suiza asimétrica — el titular ocupa la columna
     izquierda y el argumento+CTA bajan a la derecha, alineados a la base. */
  @media (min-width: 1280px) {
    .hero__cuerpo {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: var(--e-8);
      align-items: end;
    }
    .hero__lateral {
      border-left: var(--hilo) solid var(--regla);
      padding-left: var(--e-6);
    }
    .hero__sub {
      margin-top: 0;
    }
  }

  /* Momento coreografiado de carga (una vez). El titular anima SOLO transform
     (opacity fija en 1): así el LCP pinta en el primer frame y no espera al fade. */
  @media (prefers-reduced-motion: no-preference) {
    .al-t {
      animation: al-sube 420ms ease-out both;
      animation-delay: var(--d, 0s);
    }
    .al {
      animation: al-entra 450ms ease-out both;
      animation-delay: var(--d, 0s);
    }
  }
  @keyframes al-sube {
    from {
      transform: translateY(14px);
    }
    to {
      transform: none;
    }
  }
  @keyframes al-entra {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* --- Composición interna de secciones --- */
  .dato-grid {
