---
// Plantilla de la tarjeta OG (1200×630). No es una página de navegación:
// noindex, fuera del sitemap. scripts/make-og.mjs la captura con Playwright
// y el PNG resultante se commitea como public/og-v1.png.
import "../styles/tokens.css";
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <title>OG · TAKAB Ailert</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <div class="tarjeta">
      <p class="mono meta">
        <span>takabailert.com</span>
        <span class="sep"></span>
        <span>México</span>
      </p>
      <div class="marcador"></div>
      <p class="titulo">El edificio<br />se protege solo.</p>
      <p class="mono pie">
        TAKAB AILERT · Alertamiento sísmico · Continuidad operativa
      </p>
    </div>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: #071322;
    color: #f0f2f5;
  }
  .tarjeta {
    box-sizing: border-box;
    width: 1200px;
    height: 630px;
    padding: 56px 64px;
    display: flex;
    flex-direction: column;
    border: 6px solid #00bfff;
    background:
      radial-gradient(
        60rem 30rem at 90% -10%,
        rgba(0, 105, 137, 0.35),
        transparent 60%
      ),
      #071322;
  }
  .mono {
    font-family: var(--fuente-mono);
    font-size: 22px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 24px;
    color: #8a9cb1;
  }
  .sep {
    flex: 1;
    border-top: 2px solid rgba(240, 242, 245, 0.2);
  }
  .marcador {
    width: 96px;
    height: 22px;
    background: #00bfff;
    box-shadow: 0 0 24px rgba(0, 191, 255, 0.6);
    margin-top: 48px;
  }
  .titulo {
    font-family: var(--fuente-display);
    font-weight: 700;
    font-size: 150px;
    line-height: 0.92;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 24px 0 0;
  }
  .pie {
    margin-top: auto;
    color: #f0f2f5;
  }
</style>
