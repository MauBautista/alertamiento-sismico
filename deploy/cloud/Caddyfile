# Caddy: TLS + consola SOC + proxy a la API (T-1.37).
#
# El certificado lo emite Let's Encrypt sobre sslip.io (el host resuelve a la IP
# elástica sin necesidad de Route53 ni dominio propio). El desafío HTTP-01 exige el
# puerto 80 abierto al mundo; el 443 queda restringido por el security group.
{
	email {$TAKAB_ACME_EMAIL}
}

{$TAKAB_PUBLIC_HOST} {
	encode zstd gzip

	# REST y WebSocket comparten prefijo: `liveWsUrl("/api")` produce
	# `wss://host/api/ws`, y Caddy promueve el upgrade solo. `handle_path` QUITA
	# el `/api` antes de reenviar, así que FastAPI ve sus rutas tal cual (`/ws`,
	# `/sites`, …) y no hace falta root_path.
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * /srv
		# SPA: cualquier ruta desconocida la resuelve el router de React.
		try_files {path} /index.html
		file_server
	}

	# Cabeceras de endurecimiento. Sin `unsafe-eval`: MapLibre no lo necesita.
	# `connect-src` incluye wss: para el canal live y el CDN de teselas.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# [T-8.03 · D-38] CSP en modo INFORME. Desde D-38 la consola guarda la sesión
		# en localStorage (refresh token de hasta 30 días): un XSS dejaría de robar
		# una pestaña para robar un mes. La política se deriva de lo que la consola
		# pide DE VERDAD (medido con grep sobre web/src e index.html el 2026-09-22):
		#   - script: solo el bundle propio (index.html no lleva <script> en línea);
		#   - style: el propio + 'unsafe-inline' (los <style> del arranque de
		#     index.html, los `style={…}` de React y los que inyecta MapLibre);
		#   - connect: la API y el WS del propio host, el discovery de Cognito
		#     (cognito-idp) y su endpoint de token/revocación (Hosted UI), y el
		#     estilo, teselas y sprites de openfreemap;
		#   - worker/child: blob: (los workers de MapLibre);
		#   - form-action: el Hosted UI (el login es un formulario suyo).
		# Va en Report-Only hasta que el recorrido por rol contra la nube dé CERO
		# violaciones (el navegador las escribe en la consola y el recorrido las
		# recoge como console_error). Entonces se cambia el nombre de la cabecera a
		# `Content-Security-Policy` y nada más (T-8.16).
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; font-src 'self' data:; connect-src 'self' wss://{$TAKAB_PUBLIC_HOST} https://tiles.openfreemap.org https://cognito-idp.us-east-2.amazonaws.com https://*.amazoncognito.com; worker-src 'self' blob:; child-src 'self' blob:; frame-ancestors 'none'; form-action 'self' https://*.amazoncognito.com; base-uri 'self'; object-src 'none'"
		-Server
	}

	log {
		output stdout
		format console
	}
}
