[Unit]
Description=TAKAB · materializa secretos a tmpfs antes de levantar la nube
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=AWS_REGION=us-east-2
ExecStart=/opt/takab/cloud/takab-secrets.sh

[Install]
WantedBy=multi-user.target
